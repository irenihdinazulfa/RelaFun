# Salin menjadi .env (skrip start melakukannya otomatis), lalu ubah bila perlu.

# Kunci rahasia token login. Kosongkan = dibuat otomatis & disimpan di apps/api/data/.secret_key
SECRET_KEY=

# Lokasi database (default: SQLite di apps/api/data/relafun.db)
# DATABASE_URL=sqlite:///apps/api/data/relafun.db
# Supabase (PostgreSQL): salin "Session pooler" dari Supabase -> Connect, ganti [YOUR-PASSWORD].
# Karakter khusus di kata sandi (@ # / ?) harus ditulis dalam bentuk %40 %23 %2F %3F. Lihat docs/20-SUPABASE.md.
# DATABASE_URL=postgresql://postgres.<ref>:<kata-sandi>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Isi akun demo (guru, siswa, kelas RF8A26). Ubah ke 0 untuk pemakaian sungguhan.
SEED_DEMO=1

# Sasaran harian: banyak jawaban benar per hari
DAILY_GOAL=5

# --- Pemodel soal cerita berbasis AI (opsional, berbayar) ---
# Kosongkan untuk menonaktifkan. Kunci dari https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_DAILY_QUOTA=10

# --- Asisten Belajar RMT (chatbot): AI Gemini atau DeepSeek (opsional) ---
# Tempel kunci DI FILE .env (bukan di file ini, bukan di kode). File .env tidak ikut terunggah ke GitHub.
# Kunci kosong = asisten tetap jalan dalam mode terpandu tanpa AI.
# gemini | deepseek | kosong (otomatis: DeepSeek bila kuncinya ada, lalu Gemini)
TUTOR_AI_PROVIDER=
# Gemini (ada tingkat gratis): kunci dari https://aistudio.google.com/apikey
# Catatan: ketentuan Gemini API mensyaratkan usia 18+ dan tidak untuk aplikasi yang dipakai anak di bawah 18 tahun.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal = balasan cepat; low/medium/high = berpikir lebih lama
GEMINI_REASONING=minimal
# DeepSeek (berbayar): kunci dari https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# disabled = jawaban cepat tanpa mode berpikir panjang; enabled = mode berpikir (lebih lambat)
DEEPSEEK_THINKING=disabled
# Batas balasan AI per siswa per hari (setelah habis, asisten memakai petunjuk tertulis)
TUTOR_DAILY_QUOTA=60
