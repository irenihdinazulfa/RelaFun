# Salin menjadi .env (skrip start melakukannya otomatis), lalu ubah bila perlu.

# Kunci rahasia token login. Kosongkan = dibuat otomatis & disimpan di apps/api/data/.secret_key
SECRET_KEY=

# Lokasi database (default: SQLite di apps/api/data/relafun.db)
# DATABASE_URL=sqlite:///apps/api/data/relafun.db

# Isi akun demo (guru, siswa, kelas RF8A26). Ubah ke 0 untuk pemakaian sungguhan.
SEED_DEMO=1

# Sasaran harian: banyak jawaban benar per hari
DAILY_GOAL=5

# --- Pemodel soal cerita berbasis AI (opsional, berbayar) ---
# Kosongkan untuk menonaktifkan. Kunci dari https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_DAILY_QUOTA=10

# --- Asisten Belajar RMT (chatbot) dengan DeepSeek (opsional, berbayar) ---
# Tempel kunci dari https://platform.deepseek.com/api_keys DI FILE .env (bukan di file ini, bukan di kode).
# File .env tidak ikut terunggah ke GitHub. Kosongkan = asisten tetap jalan dalam mode terpandu tanpa AI.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# disabled = jawaban cepat tanpa mode berpikir panjang; enabled = mode berpikir (lebih lambat)
DEEPSEEK_THINKING=disabled
# Batas balasan AI per siswa per hari (setelah habis, asisten memakai petunjuk tertulis)
TUTOR_DAILY_QUOTA=60
